generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id               String   @id @default(cuid())
  name             String
  image            String?
  description      String?
  category         String?
  brand            String?
  sku              String?  @unique
  sellingPrice     Float
  costPrice        Float
  startingQuantity Int
  currentQuantity  Int
  lowStockLimit    Int      @default(10)
  status           String   @default("active")
  trackingActive   Boolean  @default(false)
  trackingStartDate DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  movements QuantityMovement[]

  @@index([category])
  @@index([status])
  @@index([trackingActive])
}

model QuantityMovement {
  id               String   @id @default(cuid())
  productId        String
  previousQuantity Int
  newQuantity      Int
  quantityDiff     Int
  estimatedRevenue Float
  estimatedProfit  Float
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model Settings {
  id       String @id @default("default")
  currency String @default("USD")
  timezone String @default("UTC")
  darkMode Boolean @default(false)
  lowStockThreshold Int @default(10)
  refreshInterval   Int @default(5)
}
